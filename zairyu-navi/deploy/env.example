# 复制成 deploy/.env（不要提交），按实际填写。compose.yaml 读这个文件；值的含义见 README“运行”和 docs/ops.md。
# 文件权限设成 600：chmod 600 deploy/.env

# ---- 反向代理 ----
# 对外的域名（Caddy 用它申请证书）
SITE_DOMAIN=navi.example.jp

# ---- 应用 ----
# 邮件和提醒里的链接用的地址（https:// 加上面的域名）
APP_URL=https://navi.example.jp
# 管理员令牌：名字:令牌，每个令牌至少 24 个字符（例如 openssl rand -base64 33 生成）；多个用逗号隔开
ADMIN_TOKENS=ops-a:REPLACE_WITH_RANDOM_TOKEN_AT_LEAST_24_CHARS
# 助手用的 Claude API key（不配则助手接口返回 503）
ANTHROPIC_API_KEY=
# MODEL=claude-sonnet-5-5
# EFFORT=medium
# MAX_TOKENS=8000

# ---- 发信 ----
MAIL_SENDER=http
MAIL_FROM=在留导航 <no-reply@navi.example.jp>
MAIL_HTTP_URL=https://mail-provider.example/v1/send
MAIL_HTTP_KEY=
# MAIL_HTTP_PRESET=generic
REMINDERS_ENABLED=1
# REMINDER_INTERVAL_MIN=60
# REMINDER_HOUR=9

# ---- 服务商（展示费） ----
BILLING_PLANS={"regulated":11000,"other":5500}
# 振込先说明。MAIL_SENDER 是 http 或 smtp 时 BILLING_PLANS、BILLING_BANK_TEXT、APP_URL 不填不启动
BILLING_BANK_TEXT=
# BILLING_INVOICE_REG_NO=T0000000000000

# ---- 运维 ----
# 请求日志（一行一个 JSON，写到标准输出，docker logs 看）：1 开（默认），0 关
# LOG_REQUESTS=1
# 备份留几份（docker compose exec app node tools/backup.js 每跑一次一份）
# BACKUP_KEEP=7
